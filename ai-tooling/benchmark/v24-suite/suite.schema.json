{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cangjie-v24-public.schema.json",
  "title": "Cangjie v24 public benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "schema", "cangjie_version", "target", "cpu_only", "dependencies", "tasks", "integrity"],
  "properties": {
    "id": {"type": "string", "const": "cangjie-v24-public"},
    "version": {"type": "string", "const": "24.0"},
    "schema": {"type": "string", "const": "v24-public-1"},
    "cangjie_version": {"type": "string", "const": "1.1.3"},
    "target": {"type": "string", "const": "cjnative-x86_64-w64-mingw32"},
    "cpu_only": {"type": "boolean", "const": true},
    "dependencies": {"type": "array", "maxItems": 0},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "manifest_hash_scope", "aggregate_algorithm", "aggregate_hash_scope", "files", "boundary_inventory"],
      "properties": {
        "algorithm": {"type": "string", "const": "SHA-256"},
        "manifest_hash_scope": {"type": "string", "const": "all-v24-files-except-public-suite.json"},
        "aggregate_algorithm": {"type": "string", "const": "sha256-utf8-lf-v1"},
        "aggregate_hash_scope": {"type": "string", "const": "manifest-sha256-plus-sorted-ordinal-declared-path-sha256-records"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "kind"],
            "properties": {
              "path": {"type": "string", "pattern": "^(?:[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*/(?:public/task\\.md|starter/cjpm\\.toml|starter/src/[a-z0-9]+(?:[_-][a-z0-9]+)*\\.cj|tests/public_test_[0-9]{2}\\.cj)|(?:README|COVERAGE|CALIBRATION)\\.md|suite\\.schema\\.json|scripts/[A-Za-z0-9_-]+\\.ps1)$"},
              "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
              "kind": {"type": "string", "enum": ["prompt", "config", "source", "public-test", "documentation", "schema", "script"]}
            }
          }
        },
        "boundary_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_count", "replaceable_source_count", "public_test_count", "prompt_count", "script_count", "forbidden_path_segments", "forbidden_artifact_names"],
          "properties": {
            "task_count": {"type": "integer", "const": 4},
            "replaceable_source_count": {"type": "integer", "const": 4},
            "public_test_count": {"type": "integer", "const": 16},
            "prompt_count": {"type": "integer", "const": 4},
            "script_count": {"type": "integer", "const": 3},
            "forbidden_path_segments": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}},
            "forbidden_artifact_names": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["target", "build", "x", "t", "cjpm.lock", "*.exe", "*.cjo", "*.a", "*.bc"]}}
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "prompt", "starter", "project_files", "public_tests", "api_checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
          "path": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
          "prompt": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*/public/task\\.md$"},
          "starter": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*/starter$"},
          "project_files": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^src/[a-z0-9]+(?:[_-][a-z0-9]+)*\\.cj$"}},
          "public_tests": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*/tests/public_test_[0-9]{2}\\.cj$"}},
          "api_checks": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["source", "pattern"], "properties": {"source": {"type": "string", "pattern": "^src/[a-z0-9]+(?:[_-][a-z0-9]+)*\\.cj$"}, "pattern": {"type": "string"}}}}
        }
      }
    }
  }
}
